{
  "name": "react-native-typescript-library-starter",
  "version": "3.0.0",
  "description": "A modern, AI-ready React Native TypeScript library starter with dual CJS/ESM output, full test setup, and developer-first tooling.",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/typescript/module/index.d.ts",
        "default": "./lib/module/index.js"
      },
      "require": {
        "types": "./lib/typescript/commonjs/index.d.ts",
        "default": "./lib/commonjs/index.js"
      }
    }
  },
  "source": "src/index.ts",
  "files": [
    "src",
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/kuraydev/react-native-typescript-library-starter.git"
  },
  "author": "FreakyCoder <kurayogun@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kuraydev/react-native-typescript-library-starter#readme",
  "bugs": {
    "url": "https://github.com/kuraydev/react-native-typescript-library-starter/issues"
  },
  "keywords": [
    "react-native",
    "typescript",
    "library",
    "starter",
    "template",
    "component",
    "hook",
    "ai-ready",
    "bob",
    "react-native-builder-bob"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "build": "bob build",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "husky:setup": "husky",
    "lint": "oxlint --deny-warnings src",
    "lint:ci": "oxlint --deny-warnings src",
    "format": "oxfmt src",
    "format:ci": "oxfmt --check src"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@react-native/babel-preset": "^0.87.0",
    "@react-native/jest-preset": "^0.87.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "~19.2.0",
    "babel-jest": "~29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "chalk": "^5.3.0",
    "husky": "^9.0.0",
    "jest": "~29.7.0",
    "lint-staged": "^15.2.10",
    "ora": "^8.0.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "prompts": "^2.4.2",
    "react": "^19.2.3",
    "react-native": "^0.87.0",
    "react-native-builder-bob": "^0.43.0",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --deny-warnings",
      "oxfmt"
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(jsx?|tsx?)$",
    "transformIgnorePatterns": [
      "node_modules/(?!(react-native|@react-native/.*|@react-native-community/.*|@testing-library)/)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.types.ts",
      "!src/**/index.ts",
      "!src/types/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/lib/"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "commonjs",
        {
          "esm": true
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      "typescript"
    ]
  },
  "main": "./lib/commonjs/index.js",
  "module": "./lib/module/index.js",
  "types": "./lib/typescript/commonjs/index.d.ts"
}
